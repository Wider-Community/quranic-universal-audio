{
    "extraKnownMarketplaces": {
      "qua-hub": { "source": { "source": "github", "repo": "Hetchy/qua-hub" } }
    },
    "enabledPlugins": {
      "frontend-design@claude-plugins-official": true,
      "claude-md-management@claude-plugins-official": true,
      "context7@claude-plugins-official": true,
      "qua-tracker@qua-hub": true,
      "qua-conventions@qua-hub": true,
      "qua-general@qua-hub": true,
      "qua-infra@qua-hub": true,
      "qua-domain@qua-hub": true
    },
    "permissions": {
      "allow": [
        "Bash(qstat:*)",
        "Bash(pip list:*)",
        "Bash(grep:*)",
        "Bash(head:*)",
        "Bash(cat:*)",
        "Bash(echo:*)",
        "Bash(tail:*)",
        "Bash(sed:*)",
        "Bash(awk:*)",
        "Bash(cd:*)",
        "Bash(ls:*)",
        "Bash(find:*)",
        "Bash(wc:*)",
        "Bash(rg:*)"
      ],
      "ask": []
    },
    "skillListingBudgetFraction": 0.8,
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "powershell -NoProfile -NonInteractive -File \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\lint-frontend-edit.ps1\"",
              "timeout": 15
            }
          ]
        }
      ]
    }
  }
  