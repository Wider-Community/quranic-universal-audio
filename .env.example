# Quranic Universal Audio — environment template.
# Copy to `.env` at the repo root and fill in real values. NEVER commit `.env`.
# Most local dev only needs HF_TOKEN (+ your own INSPECTOR_BUCKET_REPO if you
# have a personal dev bucket). See inspector/README.md.
#
# IMPORTANT: if you run the app via `/launch` (scripts/devenv/launch.py), the
# launcher OWNS every run-mode knob and overrides the `.env` values below —
# INSPECTOR_BACKEND, INSPECTOR_ALLOW_PROD_BUCKET, INSPECTOR_FILESYSTEM_ROOT,
# INSPECTOR_AUTO_MOUNT, INSPECTOR_READ_ONLY, INSPECTOR_DB_SYNC, INSPECTOR_DB_PATH
# (dev=DEV bucket RW, prod=PROD bucket read-only, fixtures=offline). The keys
# below matter only when hand-running `python inspector/app.py`. The launcher
# does still read INSPECTOR_BUCKET_REPO for dev (your own dev bucket) + all the
# secrets/identity below.

# --- Hugging Face access -----------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx          # HF token scoped to your repos; reads/writes your bucket. https://huggingface.co/settings/tokens
INSPECTOR_HF_TOKEN=                                 # Optional HF token override (wins over HF_TOKEN) for deploy/bucket tooling

# --- Bucket selection (run-mode knobs — /launch overrides these) -------------
INSPECTOR_BUCKET_REPO=your-hf-user/quranic-inspector-dev   # Bucket repo id; defaults to the shared dev bucket when unset (never prod)
INSPECTOR_ALLOW_PROD_BUCKET=0                       # Set 1 to allow a local process to touch the PROD bucket (dangerous; off by default). /launch forces this off in dev.
INSPECTOR_BACKEND=bucket                            # Storage backend: `bucket` (default) or `filesystem` (offline fixtures/tests)
INSPECTOR_FILESYSTEM_ROOT=                          # Root path for INSPECTOR_BACKEND=filesystem (required only in that mode)
INSPECTOR_READ_ONLY=0                               # Set 1 to refuse ALL bucket writes (storage backend rejects every mutation). /launch sets this in prod.
INSPECTOR_DB_SYNC=1                                 # Set 0 to keep DB commits local (no bucket write-back). /launch sets this in prod.
INSPECTOR_AUTO_MOUNT=1                              # Set 0 to skip the hf-mount FUSE auto-mount and read over the network instead
INSPECTOR_BUCKET_MOUNT=                             # Explicit local mount path for the bucket (auto-derived when auto-mount is on)

# --- Runtime profile ---------------------------------------------------------
FLASK_ENV=development                               # Flask environment: `development` locally, `production` when deployed
INSPECTOR_DEV_MODE=1                                # 1 = synthetic-user auth bypass (auto-set locally); deployed Spaces leave it off
INSPECTOR_BEHIND_PROXY=0                            # 1 only when running behind the HF Space TLS proxy (sets secure-cookie/proxy behaviour)
INSPECTOR_HOST=0.0.0.0                              # Bind address for the dev server

# --- Dev-mode synthetic owner identity ---------------------------------------
INSPECTOR_DEV_OWNER_HF_ID=                          # HF numeric/user id used as the actor for headless admin ops in dev
INSPECTOR_DEV_OWNER_LOGIN=                          # HF login (username) paired with INSPECTOR_DEV_OWNER_HF_ID

# --- OAuth (deployed Spaces; injected automatically by HF when hf_oauth=true)-
OAUTH_CLIENT_ID=                                    # HF OAuth client id; injected by the Space, leave blank locally
OAUTH_CLIENT_SECRET=                               # HF OAuth client secret; injected by the Space, leave blank locally
OPENID_PROVIDER_URL=https://huggingface.co         # OpenID provider base URL (HF by default)
OAUTH_SCOPES=openid profile                         # OAuth scopes requested at login
INSPECTOR_SESSION_SECRET=                           # Secret that signs login cookies (auto-generated on Space bootstrap)
INSPECTOR_PUBLIC_URL=                               # Public base URL of the deployed Space (used to build OAuth redirect URIs)

# --- GitHub integration ------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx     # GitHub token for CI reciter-build + request helpers
INSPECTOR_GH_RELEASE_TOKEN=                         # GitHub token (Contents:write) the cut-release job uses to publish GH releases
INSPECTOR_GITHUB_DISPATCH_TOKEN=                    # GitHub token for repository_dispatch triggers from the app

# --- HF Jobs / webhooks ------------------------------------------------------
INSPECTOR_WEBHOOK_URL=                              # Callback URL HF Jobs POST progress/results to
INSPECTOR_WEBHOOK_SECRET=                           # Shared secret signing/verifying job webhook payloads
INSPECTOR_JOB_IMAGE=                                # Docker image used to run HF Jobs (defaults to the public job image)
INSPECTOR_ALIGNER_BUCKET=                           # Aligner job staging bucket id

# --- Quran Foundation API (optional) -----------------------------------------
QF_PREPROD_CLIENT_ID=                               # Quran Foundation pre-prod OAuth client id
QF_PREPROD_CLIENT_SECRET=                          # Quran Foundation pre-prod OAuth client secret
QF_CONTENT_CLIENT_ID=                               # Quran Foundation content API client id
QF_CONTENT_CLIENT_SECRET=                          # Quran Foundation content API client secret
