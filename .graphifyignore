# graphify ignore — keep the knowledge graph high-signal.
# gitignore syntax; merged with .gitignore (these win on conflict).
# Already auto-skipped by graphify: node_modules/ dist/ build/ caches/
# lockfiles/ .svelte-kit/ .worktrees/ graphify-out/ — no need to repeat.

# --- Agent / editor / meta tooling (not product architecture) ---
.claude/
.impeccable
.impeccable/
.husky/

# --- Generated / codegen'd (would mislead the graph) ---
inspector/frontend/src/lib/types/generated/

# --- Screen-recording demos & throwaway design mockups (not architecture) ---
inspector/captures/
inspector/frontend/design/prototypes/

# --- Static assets & media (no architectural signal; avoids vision-agent waste) ---
inspector/frontend/public/
**/*.svg
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.ico
**/*.otf
**/*.ttf
**/*.woff
**/*.woff2
**/*.mp3
**/*.wav
**/*.m4a
**/*.ogg

# --- Binary / compressed data blobs ---
**/*.gz
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.parquet
**/*.onnx
**/*.bin
**/*.pdf

# --- Minified / sourcemaps ---
**/*.min.js
**/*.min.css
**/*.map

# --- Local-only, bucket mounts, coverage (mostly gitignored already) ---
.local/
.playwright-mcp/
coverage/
.coverage
.coverage.*
inspector/.bucket/
