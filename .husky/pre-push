#!/usr/bin/env sh
set -e

zero_hash="0000000000000000000000000000000000000000"
run_inspector_checks=false

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip ref deletions.
  if [ "$local_sha" = "$zero_hash" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_hash" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  changed_paths="$(git diff --name-only "$range")"
  for path in $changed_paths; do
    case "$path" in
      inspector/frontend/*)
        run_inspector_checks=true
        break
        ;;
    esac
  done

  if [ "$run_inspector_checks" = "true" ]; then
    break
  fi
done

if [ "$run_inspector_checks" != "true" ]; then
  echo "pre-push: no inspector/frontend changes in pushed commits; skipping frontend checks."
  exit 0
fi

cd inspector/frontend || exit 1

# Rollup ships native bindings as optional dependencies. When this worktree is
# shared between Windows and WSL, node_modules can be present but missing the
# binding for the shell running this hook; repair that install before checks.
if ! node -e "require('rollup/dist/native.js')" >/dev/null 2>&1; then
  echo "pre-push: installing missing frontend optional dependencies for this platform..."
  npm install --include=optional
fi

npm run lint
# tsc only — avoids loading Vite/Rollup via svelte.config.js.
# Full `npm run check` runs in CI (docker-publish).
npm run typecheck
npm run test
